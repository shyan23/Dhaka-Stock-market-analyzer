# Environment-specific configurations for Stock Market Analyzer

# Default environment (can be overridden by deployment)
ENVIRONMENT=production

# Application configuration
APP_NAME=stock-market-analyzer
APP_VERSION=${GITHUB_SHA:-latest}
APP_PORT=8501

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Application mode (redis or google_sheets)
APP_MODE=redis

# DSE API configuration
DSE_API_TIMEOUT=15
UPDATE_INTERVAL_MINUTES=5

# Yahoo Finance fallback
YAHOO_FINANCE_ENABLED=true

# Streamlit configuration
STREAMLIT_SERVER_PORT=${APP_PORT}
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Health check endpoint
HEALTH_CHECK=/health

# Logging configuration
LOG_LEVEL=INFO